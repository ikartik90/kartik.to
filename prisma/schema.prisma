generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Described in `src/data/post-categories.ts`; a new value needs a reading route at its prefix.
enum PostCategory {
  ARTICLE
  WORK
  PROTOTYPE
  PAGE
}

model Post {
  id             String       @id @default(cuid())
  title          String?
  slug           String       @unique
  // Old slugs, redirected permanently (`findMovedPostPath`). Written only by the renaming save.
  previousSlugs  String[]     @default([])
  category       PostCategory @default(ARTICLE)
  content        Json
  // Null falls back to the summary of the opening paragraph (`postDescription`).
  description    String?
  coverImageKey  String?
  // The homepage card's shape; null is 16:9. A String validated in Zod, like `Component.aspect`.
  aspect         String?
  publishedAt    DateTime?
  untitledIndex  Int?
  // Homepage pin; null places the card by `publishedAt`. Same rules as `Component.gridIndex`.
  gridIndex      Int?
  // Grid columns the card spans; null is one.
  gridSpan       Int?
  // Card overrides (`PostCardConfigSchema`); null draws the derived card.
  card           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// A demo's publication on the homepage grid. `registry.ts` lists every demo, not the published set.
model Component {
  id          String    @id @default(cuid())
  // Registry key. Not unique: one demo may be published more than once.
  componentId String
  // Overrides of the registry entry; null tracks the entry. Written only through `ComponentSchema`.
  aspect      String?
  logger      Boolean?
  // The link card's config (`LinkCardConfigSchema`); null on every other row, read leniently.
  props       Json?
  // Same meaning as `Post.gridIndex` / `Post.gridSpan`.
  gridIndex   Int?
  gridSpan    Int?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// A saved shader background. Shapeless: the embedding host owns aspect, size and corners.
model ShaderPreset {
  id            String   @id @default(cuid())
  title         String?
  untitledIndex Int?
  // One of `SHADER_IDS`; a String validated through `ShaderPresetContentSchema`, not an enum.
  shaderId      String
  // Everything whose shape depends on `shaderId` (`ShaderPresetContentSchema`).
  settings      Json
  // Null keeps the preset private; every public read filters on it.
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserProfile {
  id              String   @id @default(cuid())
  neonUserId      String   @unique
  githubLogin     String?  @unique
  email           String?  @unique
  displayName     String?
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Submitted by anyone holding the `/vouch` link, only through `TestimonialSubmissionSchema`.
// No natural key: a unique `name` would let anyone overwrite somebody else's words.
model Testimonial {
  id          String   @id @default(cuid())
  name        String
  // No `@db.VarChar`: the limit is `TESTIMONIAL_QUOTE_MAX_LENGTH`.
  quote       String
  createdAt   DateTime @default(now())
  // The columns below are set from the admin board, not the form.
  avatarUrl   String?
  // The role line under the name, e.g. "Senior Product Designer at Shyft".
  tagline     String?
  // Typed by the admin; deliberately not unique.
  linkedinUrl String?
  // A verbatim substring of `quote` (enforced in `updateTestimonialDetails`); null shows it all.
  excerpt     String?
  // Null keeps it off the homepage until reviewed.
  publishedAt DateTime?
}

/// An icon's name and search words; a row exists only when they differ from the filename.
model Icon {
  /// The R2 object key.
  key       String   @id
  /// Never empty: clearing the fields deletes the row.
  title     String
  /// Search words; not unique across icons.
  aliases   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
